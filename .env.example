# ============================================================================
# Nexus Project — Environment variables
# Copy sang .env và điền giá trị. KHÔNG commit file .env lên git.
# ============================================================================

# --- Supabase ---
# Lấy tại: Supabase Dashboard → Project Settings → API
# Khi để trống, app chạy ở CHẾ ĐỘ XEM TRƯỚC NỘI BỘ (dữ liệu mẫu lưu trên trình duyệt).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Discord OAuth & Server Gatekeeper (Bảo mật nội bộ) ---
# ID của Discord Server (Guild) nội bộ Ban Công Nghệ.
# Hệ thống sẽ kiểm tra danh sách server của user; chỉ tài khoản thuộc Server này mới được phép đăng nhập.
# Người ngoài không thể tự do đăng ký.
VITE_DISCORD_GUILD_ID=1337249537072435281

# --- Chế độ demo ---
# true: luôn dùng dữ liệu mẫu kể cả khi đã cấu hình Supabase (phục vụ test UI)
VITE_DEMO_MODE=false
